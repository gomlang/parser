package tests;

use ecosystem::parser::binary;
use std::testing;

#[test]
fn go_varint_vectors() -> () {
    testing::assert_eq(
        testing::expect_ok(binary::uleb128().parse(b"\x00".as_slice()), "Go Uvarint"),
        0,
    );
    testing::assert_eq(
        testing::expect_ok(binary::zigzag64().parse(b"\x00".as_slice()), "Go Varint"),
        0,
    );
    testing::assert_eq(
        testing::expect_ok(binary::uleb128().parse(b"\x01".as_slice()), "Go Uvarint"),
        1,
    );
    testing::assert_eq(
        testing::expect_ok(binary::zigzag64().parse(b"\x01".as_slice()), "Go Varint"),
        -1,
    );
    testing::assert_eq(
        testing::expect_ok(binary::uleb128().parse(b"\x7f".as_slice()), "Go Uvarint"),
        127,
    );
    testing::assert_eq(
        testing::expect_ok(binary::zigzag64().parse(b"\x7f".as_slice()), "Go Varint"),
        -64,
    );
    testing::assert_eq(
        testing::expect_ok(binary::uleb128().parse(b"\x80\x01".as_slice()), "Go Uvarint"),
        128,
    );
    testing::assert_eq(
        testing::expect_ok(binary::zigzag64().parse(b"\x80\x01".as_slice()), "Go Varint"),
        64,
    );
    testing::assert_eq(
        testing::expect_ok(binary::uleb128().parse(b"\xff\x01".as_slice()), "Go Uvarint"),
        255,
    );
    testing::assert_eq(
        testing::expect_ok(binary::zigzag64().parse(b"\xff\x01".as_slice()), "Go Varint"),
        -128,
    );
    testing::assert_eq(
        testing::expect_ok(binary::uleb128().parse(b"\x80\x02".as_slice()), "Go Uvarint"),
        256,
    );
    testing::assert_eq(
        testing::expect_ok(binary::zigzag64().parse(b"\x80\x02".as_slice()), "Go Varint"),
        128,
    );
    testing::assert_eq(
        testing::expect_ok(
            binary::uleb128().parse(b"\x80\x80\x80\x80\x80\x80\x80\x80\x80\x01".as_slice()),
            "Go Uvarint",
        ),
        9223372036854775808,
    );
    testing::assert_eq(
        testing::expect_ok(
            binary::zigzag64().parse(b"\x80\x80\x80\x80\x80\x80\x80\x80\x80\x01".as_slice()),
            "Go Varint",
        ),
        4611686018427387904,
    );
    testing::assert_eq(
        testing::expect_ok(
            binary::uleb128().parse(b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\x01".as_slice()),
            "Go Uvarint",
        ),
        18446744073709551615,
    );
    testing::assert_eq(
        testing::expect_ok(
            binary::zigzag64().parse(b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\x01".as_slice()),
            "Go Varint",
        ),
        -9223372036854775807 - 1,
    );
    testing::assert_eq(
        testing::expect_ok(
            binary::uleb128().parse(b"\xd3\x98\xfe\xb3\x99\x96\xd9\xdf\xaf\x01".as_slice()),
            "Go Uvarint",
        ),
        12663951391086054483,
    );
    testing::assert_eq(
