            binary::zigzag64().parse(b"\x8b\xf5\xe1\xa5\xf1\xd3\x9c\xef\xfe\x01".as_slice()),
            "Go Varint",
        ),
        -9182621179018231110,
    );
    testing::assert_eq(
        testing::expect_ok(
            binary::uleb128().parse(b"\xba\xb9\xb1\xa3\xdd\xbf\xd3\x9c\x88\x01".as_slice()),
            "Go Uvarint",
        ),
        9815962615416642746,
    );
    testing::assert_eq(
        testing::expect_ok(
            binary::zigzag64().parse(b"\xba\xb9\xb1\xa3\xdd\xbf\xd3\x9c\x88\x01".as_slice()),
            "Go Varint",
        ),
        4907981307708321373,
    );
    testing::assert_eq(
        testing::expect_ok(
            binary::uleb128().parse(b"\xac\xa4\xd2\x95\xab\x83\xb2\x89\xb7\x01".as_slice()),
            "Go Uvarint",
        ),
        13191826275514487340,
    );
    testing::assert_eq(
        testing::expect_ok(
            binary::zigzag64().parse(b"\xac\xa4\xd2\x95\xab\x83\xb2\x89\xb7\x01".as_slice()),
            "Go Varint",
        ),
        6595913137757243670,
    );
}
