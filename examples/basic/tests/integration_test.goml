package tests;

use ecosystem::parser;
use ecosystem::proptest;
use ecosystem::parser::examples::basic as basic;
use std::testing;

#[test]
fn recovering_configuration_preserves_partial_results_across_modules() -> () {
    let report = testing::expect_ok(
        basic::configuration(" port = 8080;bad=[1;2];threads=no; workers=4;"),
        "configuration",
    );
    testing::assert(report.value == Vec::from_array([("port", 8080), ("workers", 4)]));
    testing::assert_eq(report.errors.len(), 2);
    testing::assert(report.errors[0].committed);
    testing::assert(report.errors[0].offset < report.errors[1].offset);
}

#[test]
fn contextual_custom_parser_preserves_exported_work_budget() -> () {
    let parser = parser::Parser::with_context(
        |context, input, offset| {
            parser::integer().then(parser::literal("!")).parse_in(context, input, offset)
        },
    );
    let context = testing::expect_ok(
        parser::ParseContext::new(parser::ParseLimits { max_depth: 30, max_work: 100 }),
        "context",
    );
    let ((value, _), next) = testing::expect_ok(parser.parse_in(context, "42!", 0), "custom parser");
    testing::assert_eq(value, 42);
    testing::assert_eq(next, 3);
    testing::assert(context.work_used() > 3);
    testing::assert(context.peak_depth() > 1);
    testing::assert_err(
        parser.parse_with_limits("42!", parser::ParseLimits { max_depth: 30, max_work: 2 }),
    );
}

#[test]
fn integer_and_list_roundtrips_across_modules() -> () {
    let integers = testing::expect_ok(proptest::integers(-100000, 100000), "integers");
    testing::assert_none(
        testing::expect_ok(
            proptest::check(
                integers,
                proptest::Config::new(2026),
                |value: isize| {
                    parser::integer().parse(value.to_string()).unwrap_or(100001) == value
                },
            ),
            "integer roundtrip",
        ),
    );
    let vectors = testing::expect_ok(proptest::vectors(integers, 0, 20), "vectors");
    testing::assert_none(
        testing::expect_ok(
            proptest::check(
                vectors,
                proptest::Config::new(27),
                |values: Vec[isize]| {
                    let text = values.join(",");
                    match parser::integer().separated(parser::literal(","), 0, false).parse(text) {
                        Ok(parsed) => parsed == values,
                        Err(_) => false,
                    }
                },
            ),
            "list roundtrip",
        ),
    );
}

#[test]
fn downstream_sentinel_records_stop_before_eof() -> () {
    let records = parser::integer().left(parser::literal(";")).many_until(parser::literal("END"));
    let ((values, ending), rest) = testing::expect_ok(
        records.parse_prefix("1;2;ENDtail"),
        "records",
    );
    testing::assert(values == Vec::from_array([1, 2]));
    testing::assert_eq(ending, "END");
    testing::assert_eq(rest, "tail");
}
