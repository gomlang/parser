package binary;

use ecosystem::parser;

impl[T] Parser[T] {
    pub fn many_until[U](self: Parser[T], terminator: Parser[U]) -> Parser[(Vec[T], U)] {
        Parser::with_context(
            |context, input, offset| {
                let values: Vec[T] = Vec::new();
                let mut next = offset;
                loop {
                    let boundary_error = match terminator.parse_in(context, input, next) {
                        Ok((end, after)) => return Result::Ok(((values, end), after)),
                        Err(Error::Invalid(problem)) => {
                            if problem.committed {
                                return Result::Err(Error::Invalid(problem))
                            }
                            problem
                        },
                        Err(incomplete) => return Result::Err(incomplete),
                    };
                    match self.parse_in(context, input, next) {
                        Ok((value, after)) => {
                            if after == next {
                                return Result::Err(
                                    Error::Invalid(
                                        parser::Error {
                                            offset: next,
                                            expected: "binary repetition must consume input",
                                            committed: true,
                                        },
                                    ),
                                )
                            }
                            values.push(value);
                            next = after;
                        },
                        Err(Error::Invalid(problem)) => {
                            if problem.committed || problem.offset > boundary_error.offset {
                                return Result::Err(Error::Invalid(problem))
                            }
                            if boundary_error.offset > problem.offset {
                                return Result::Err(Error::Invalid(boundary_error))
                            }
                            context.charge(
                                boundary_error.expected.byte_len() + problem.expected.byte_len(),
                                next,
                            ).map_err(|problem| Error::Invalid(problem))?;
                            return Result::Err(
                                Error::Invalid(
                                    parser::error(
                                        problem.offset,
                                        boundary_error.expected + " or " + problem.expected,
                                    ),
                                ),
                            )
                        },
                        Err(incomplete) => return Result::Err(incomplete),
                    }
                }
            },
        )
    }

    pub fn or(self: Parser[T], other: Parser[T]) -> Parser[T] {
        Parser::with_context(
            |context, input, offset| {
                let first = match self.parse_in(context, input, offset) {
                    Ok(value) => return Result::Ok(value),
                    Err(Error::Invalid(problem)) => {
                        if problem.committed {
                            return Result::Err(Error::Invalid(problem))
                        }
                        problem
                    },
                    Err(incomplete) => return Result::Err(incomplete),
                };
                match other.parse_in(context, input, offset) {
                    Ok(value) => Result::Ok(value),
                    Err(Error::Invalid(second)) => {
                        if second.committed || second.offset > first.offset {
                            Result::Err(Error::Invalid(second))
                        } else if first.offset > second.offset {
                            Result::Err(Error::Invalid(first))
                        } else {
                            context.charge(
                                first.expected.byte_len() + second.expected.byte_len(),
                                offset,
                            ).map_err(|problem| Error::Invalid(problem))?;
                            Result::Err(
                                Error::Invalid(
                                    parser::error(
                                        first.offset,
                                        first.expected + " or " + second.expected,
                                    ),
                                ),
                            )
                        }
                    },
                    Err(incomplete) => Result::Err(incomplete),
                }
            },
        )
    }

    pub fn cut(self: Parser[T]) -> Parser[T] {
        Parser::with_context(
            |context, input, offset| self.parse_in(context, input, offset).map_err(
                |problem| match problem {
                    Error::Invalid(problem) => Error::Invalid(
                        parser::Error { committed: true, ..problem },
                    ),
                    incomplete => incomplete,
                },
            ),
        )
    }

    pub fn attempt(self: Parser[T]) -> Parser[T] {
        Parser::with_context(
            |context, input, offset| self.parse_in(context, input, offset).map_err(
                |problem| match problem {
                    Error::Invalid(problem) => Error::Invalid(
                        parser::Error { committed: false, ..problem },
                    ),
                    incomplete => incomplete,
                },
            ),
        )
    }

    pub fn optional(self: Parser[T]) -> Parser[Option[T]] {
        Parser::with_context(
            |context, input, offset| match self.parse_in(context, input, offset) {
                Ok((value, next)) => Result::Ok((Option::Some(value), next)),
                Err(Error::Invalid(problem)) => if problem.committed {
                    Result::Err(Error::Invalid(problem))
                } else {
                    Result::Ok((Option::None, offset))
                },
                Err(incomplete) => Result::Err(incomplete),
            },
        )
    }

    pub fn peek(self: Parser[T]) -> Parser[T] {
        Parser::with_context(
            |context, input, offset| {
                let (value, _) = self.parse_in(context, input, offset)?;
                Result::Ok((value, offset))
            },
        )
    }

    pub fn not(self: Parser[T], expected: string) -> Parser[()] {
        Parser::with_context(
            |context, input, offset| match self.parse_in(context, input, offset) {
                Ok(_) => Result::Err(Error::Invalid(parser::error(offset, expected))),
                Err(Error::Invalid(problem)) => if problem.committed {
                    Result::Err(Error::Invalid(problem))
                } else {
                    Result::Ok(((), offset))
                },
                Err(incomplete) => Result::Err(incomplete),
            },
        )
    }

    pub fn verify(self: Parser[T], accept: (T) -> bool, expected: string) -> Parser[T] {
        self.try_map(
            |value| if accept(value) {
                Result::Ok(value)
            } else {
                Result::Err(expected)
            },
        )
    }

    pub fn between[L, R](self: Parser[T], left: Parser[L], right: Parser[R]) -> Parser[T] {
        left.right(self.left(right).cut())
    }
}

pub fn pure[T](value: T) -> Parser[T] {
    Parser::with_context(|_, _, offset| Result::Ok((value, offset)))
}

pub fn lazy[T](build: () -> Parser[T]) -> Parser[T] {
    Parser::with_context(|context, input, offset| build().parse_in(context, input, offset))
}

pub fn end() -> Parser[()] {
    Parser::with_context(
        |_, input: Slice[byte], offset| {
            if offset == input.len() {
                Result::Ok(((), offset))
            } else {
                Result::Err(Error::Invalid(parser::error(offset, "end of binary input")))
            }
        },
    )
}
