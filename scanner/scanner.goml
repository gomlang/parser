package scanner;

use std::unicode;

#[derive(Debug, PartialEq, Eq)]
pub struct Position {
    pub offset: isize,
    pub line: isize,
    pub column: isize,
}

#[derive(Debug, PartialEq, Eq)]
pub enum Kind {
    Identifier,
    Number,
    Quoted,
    Punctuation,
    Whitespace,
    Comment,
}

#[derive(Debug, PartialEq, Eq)]
pub struct Token {
    pub kind: Kind,
    pub text: string,
    pub start: Position,
    pub end: Position,
}

#[derive(Debug, PartialEq, Eq)]
pub enum ErrorKind {
    Options,
    Limit,
    Unterminated,
}

#[derive(Debug, PartialEq, Eq)]
pub struct Error {
    pub kind: ErrorKind,
    pub position: Position,
    pub message: string,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        self.message + " at byte " + self.position.offset.to_string() + ", line "
            + self.position.line.to_string()
            + ", column "
            + self.position.column.to_string()
    }
}

#[derive(Debug, PartialEq, Eq)]
pub struct Options {
    pub max_token_bytes: isize,
    pub emit_whitespace: bool,
    pub line_comments: bool,
    pub block_comments: bool,
    pub emit_comments: bool,
}

impl Options {
    pub fn standard(max_token_bytes: isize) -> Options {
        Options {
            max_token_bytes,
            emit_whitespace: false,
            line_comments: false,
            block_comments: false,
            emit_comments: false,
        }
    }
}

pub struct Scanner {
    input: string,
    options: Options,
    cursor: Ref[Position],
    failure: Ref[Option[Error]],
}

impl Scanner {
    pub fn new(input: string, max_token_bytes: isize) -> Result[Scanner, Error] {
        Scanner::with_options(input, Options::standard(max_token_bytes))
    }

    pub fn with_options(input: string, options: Options) -> Result[Scanner, Error] {
        let start = Position { offset: 0, line: 1, column: 1 };
        if options.max_token_bytes <= 0 {
            return Result::Err(
                Error {
                    kind: ErrorKind::Options,
                    position: start,
                    message: "max_token_bytes must be positive",
                },
            )
        }
        Result::Ok(
            Scanner { input, options, cursor: Ref::new(start), failure: Ref::new(Option::None) },
        )
    }

    pub fn position(self: Scanner) -> Position {
        self.cursor.get()
    }

    pub fn failure(self: Scanner) -> Option[Error] {
        self.failure.get()
    }

    fn current(self: Scanner) -> Option[char] {
        self.input.decode_at(self.cursor.get().offset).map(|decoded| decoded.0)
    }

    fn advance(self: Scanner) -> () {
        let position = self.cursor.get();
        if let Some((value, width)) = self.input.decode_at(position.offset) {
            if value == '\n' {
                self.cursor.set(
                    Position { offset: position.offset + 1, line: position.line + 1, column: 1 },
                );
            } else {
                self.cursor.set(
                    Position {
                        offset: position.offset + width,
                        line: position.line,
                        column: position.column + 1,
                    },
                );
            }
        }
    }

    fn checked(self: Scanner, start: Position) -> Result[(), Error] {
        if self.cursor.get().offset - start.offset > self.options.max_token_bytes {
            Result::Err(
                Error {
                    kind: ErrorKind::Limit,
                    position: start,
                    message: "token byte limit exceeded",
                },
            )
        } else {
            Result::Ok(())
        }
    }

    fn take(self: Scanner, start: Position) -> Result[(), Error] {
        self.advance();
        self.checked(start)
    }

    fn token(self: Scanner, kind: Kind, start: Position) -> Token {
        let end = self.cursor.get();
        Token { kind, text: self.input.byte_slice(start.offset, end.offset), start, end }
    }

    fn scan(self: Scanner) -> Result[Option[Token], Error] {
        loop {
            let start = self.position();
            let first = match self.current() {
                Some(value) => value,
                None => return Result::Ok(Option::None),
            };
            if unicode::is_whitespace(first) {
                while let Some(value) = self.current() {
                    if !unicode::is_whitespace(value) {
                        break;
                    }
                    self.take(start)?;
                }
                if self.options.emit_whitespace {
                    return Result::Ok(Option::Some(self.token(Kind::Whitespace, start)))
                }
                continue;
            }
            if self.options.line_comments && self.input.starts_with_at(start.offset, "//") {
                self.take(start)?;
                self.take(start)?;
                while let Some(value) = self.current() {
                    if value == '\n' {
                        break;
                    }
                    self.take(start)?;
                }
                if self.options.emit_comments {
                    return Result::Ok(Option::Some(self.token(Kind::Comment, start)))
                }
                continue;
            }
            if self.options.block_comments && self.input.starts_with_at(start.offset, "/*") {
                self.take(start)?;
                self.take(start)?;
                loop {
                    if self.current().is_none() {
                        return Result::Err(
                            Error {
                                kind: ErrorKind::Unterminated,
                                position: start,
                                message: "unterminated block comment",
                            },
                        )
                    }
                    if self.input.starts_with_at(self.position().offset, "*/") {
                        self.take(start)?;
                        self.take(start)?;
                        break;
                    }
                    self.take(start)?;
                }
                if self.options.emit_comments {
                    return Result::Ok(Option::Some(self.token(Kind::Comment, start)))
                }
                continue;
            }
            if unicode::is_letter(first) || first == '_' {
                self.take(start)?;
                while let Some(value) = self.current() {
                    if !(unicode::is_letter(value) || unicode::is_number(value) || value == '_') {
                        break;
                    }
                    self.take(start)?;
                }
                return Result::Ok(Option::Some(self.token(Kind::Identifier, start)))
            }
            if unicode::is_digit(first) {
                self.take(start)?;
                while let Some(value) = self.current() {
                    if !unicode::is_digit(value) {
                        break;
                    }
                    self.take(start)?;
                }
                return Result::Ok(Option::Some(self.token(Kind::Number, start)))
            }
            if first == '"' || first == '\'' {
                self.take(start)?;
                loop {
                    let value = match self.current() {
                        Some(value) => value,
                        None => {
                            return Result::Err(
                                Error {
                                    kind: ErrorKind::Unterminated,
                                    position: start,
                                    message: "unterminated quoted token",
                                },
                            )
                        },
                    };
                    if value == '\n' {
                        return Result::Err(
                            Error {
                                kind: ErrorKind::Unterminated,
                                position: start,
                                message: "newline in quoted token",
                            },
                        )
                    }
                    self.take(start)?;
                    if value == first {
                        return Result::Ok(Option::Some(self.token(Kind::Quoted, start)))
                    }
                    if value == '\\' {
                        let escaped = match self.current() {
                            Some(escaped) => escaped,
                            None => {
                                return Result::Err(
                                    Error {
                                        kind: ErrorKind::Unterminated,
                                        position: start,
                                        message: "unterminated quoted escape",
                                    },
                                )
                            },
                        };
                        if escaped == '\n' {
                            return Result::Err(
                                Error {
                                    kind: ErrorKind::Unterminated,
                                    position: start,
                                    message: "newline in quoted escape",
                                },
                            )
                        }
                        self.take(start)?;
                    }
                }
            }
            self.take(start)?;
            return Result::Ok(Option::Some(self.token(Kind::Punctuation, start)))
        }
    }

    pub fn next(self: Scanner) -> Result[Option[Token], Error] {
        if let Some(problem) = self.failure.get() {
            return Result::Err(problem)
        }
        match self.scan() {
            Ok(token) => Result::Ok(token),
            Err(problem) => {
                self.failure.set(Option::Some(problem));
                Result::Err(problem)
            },
        }
    }
}
